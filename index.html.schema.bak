    <!-- Main Navigation Tabs -->
    <nav class="nav-tabs">
        <div class="container">
            <button class="nav-tab active" data-tab="visualizer">
                <span class="nav-tab__icon">👁️</span>
                <span class="nav-tab__text">Visualizer</span>
            </button>
            <button class="nav-tab" data-tab="try-on">
                <span class="nav-tab__icon">📸</span>
                <span class="nav-tab__text">Virtual Try-On</span>
            </button>
            <button class="nav-tab" data-tab="compare">
                <span class="nav-tab__icon">⚖️</span>
                <span class="nav-tab__text">Size Compare</span>
            </button>
            <button class="nav-tab" data-tab="anatomy">
                <span class="nav-tab__icon">🎯</span>
