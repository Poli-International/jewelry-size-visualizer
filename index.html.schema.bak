    <!-- Main Content Container -->
    <main class="main">
        <div class="container">

            <!-- Tab 1: Interactive Visualizer -->
            <section id="tab-visualizer" class="tab-content active">
                <div class="section-header">
                    <h2 class="section-title">Interactive Jewelry Visualizer</h2>
                    <p class="section-description">View jewelry at true 1:1 scale on your screen. All measurements shown in both imperial and metric.</p>
                </div>

                <!-- Calibration Banner -->
                <div class="calibration-banner" id="calibration-banner">
                    <div class="calibration-banner__content">
                        <span class="calibration-banner__icon">⚠️</span>
                        <div class="calibration-banner__text">
                            <strong>Calibration Required:</strong> For accurate 1:1 scale display, please calibrate your screen first.
                        </div>
                        <button class="btn btn--primary btn--small" id="calibrate-button">Calibrate Now</button>
                    </div>
                </div>

                <!-- Filter Controls -->
                <div class="filter-panel">
                    <div class="filter-group" style="grid-column: 1 / -1;">
                        <p style="font-size: 0.875rem; color: var(--text-tertiary); margin-bottom: 0.5rem;">
                            <strong>💡 Tip:</strong> Showing popular items by default for faster loading. Use filters below to see all items.
                        </p>
                    </div>
                    <div class="filter-group">
                        <label for="filter-category" class="filter-label">Category:</label>
                        <select id="filter-category" class="filter-select">
                            <option value="all">All Jewelry</option>
                            <option value="rings">Rings</option>
                            <option value="labrets">Labrets & Studs</option>
                            <option value="barbells">Barbells</option>
                            <option value="circular">Circular Barbells & Horseshoes</option>
                            <option value="captive">Ball Closure Rings (BCR)</option>
                            <option value="clickers">Clickers & Seamless</option>
                            <option value="plugs">Plugs & Tunnels</option>
                        </select>
                    </div>

                    <div class="filter-group">
                        <label for="filter-gauge" class="filter-label">Gauge:</label>
                        <select id="filter-gauge" class="filter-select">
                            <option value="all">All Gauges</option>
                            <option value="20g">20g (0.8mm)</option>
                            <option value="18g">18g (1.0mm)</option>
                            <option value="16g">16g (1.2mm)</option>
                            <option value="14g">14g (1.6mm)</option>
                            <option value="12g">12g (2.0mm)</option>
                            <option value="10g">10g (2.4mm)</option>
                            <option value="8g">8g (3.2mm)</option>
                            <option value="6g">6g (4.0mm)</option>
                            <option value="4g">4g (5.0mm)</option>
                            <option value="2g">2g (6.0mm)</option>
                            <option value="0g">0g (8.0mm)</option>
                            <option value="00g">00g (10.0mm)</option>
                        </select>
                    </div>

                    <div class="filter-group">
                        <label for="filter-material" class="filter-label">Material:</label>
                        <select id="filter-material" class="filter-select">
                            <option value="all">All Materials</option>
                            <option value="titanium">Implant-Grade Titanium</option>
                            <option value="steel">Surgical Steel</option>
                            <option value="gold">14k/18k Gold</option>
                            <option value="niobium">Niobium</option>
                            <option value="glass">Glass</option>
                            <option value="stone">Stone</option>
                            <option value="acrylic">Acrylic</option>
                        </select>
                    </div>

                    <div class="filter-group">
                        <label for="filter-location" class="filter-label">Body Location:</label>
                        <select id="filter-location" class="filter-select">
                            <option value="all">All Locations</option>
                            <option value="ear">Ear</option>
                            <option value="nose">Nose</option>
                            <option value="lip">Lip</option>
                            <option value="tongue">Tongue</option>
                            <option value="eyebrow">Eyebrow</option>
                            <option value="navel">Navel</option>
                            <option value="nipple">Nipple</option>
                            <option value="surface">Surface</option>
                            <option value="genital">Genital (All)</option>
                            <option value="male-genital">Male Genital</option>
                            <option value="female-genital">Female Genital</option>
                        </select>
                    </div>
                </div>

                <!-- Jewelry Gallery -->
                <div class="jewelry-gallery" id="jewelry-gallery">
                    <!-- Jewelry items will be dynamically populated by JavaScript -->
                    <div class="gallery-loading">
                        
                        <p>Loading jewelry database...</p>
                    </div>
                </div>

                <!-- Selected Jewelry Detail View -->
                <div class="jewelry-detail" id="jewelry-detail" style="display: none;">
                    <div class="jewelry-detail__close" id="detail-close">✕</div>
                    <div class="jewelry-detail__content">
                        <div class="jewelry-detail__visual">
                            <h3 class="jewelry-detail__title">1:1 Scale Preview</h3>
                            <div class="jewelry-detail__canvas-wrapper">
                                <canvas id="jewelry-canvas" class="jewelry-detail__canvas"></canvas>
                            </div>
                            <div class="jewelry-detail__ruler" id="detail-ruler">
                                <!-- Ruler markings for scale reference -->
                            </div>
                        </div>
                        <div class="jewelry-detail__info">
                            <h2 id="detail-name">Jewelry Name</h2>
                            <div class="jewelry-detail__specs">
                                <div class="spec-row">
                                    <span class="spec-label">Gauge:</span>
                                    <span class="spec-value" id="detail-gauge">--</span>
                                </div>
                                <div class="spec-row">
                                    <span class="spec-label">Diameter/Length:</span>
                                    <span class="spec-value" id="detail-size">--</span>
                                </div>
                                <div class="spec-row">
                                    <span class="spec-label">Material:</span>
                                    <span class="spec-value" id="detail-material">--</span>
                                </div>
                                <div class="spec-row">
                                    <span class="spec-label">Recommended For:</span>
                                    <span class="spec-value" id="detail-locations">--</span>
                                </div>
                            </div>
                            <div class="jewelry-detail__comparisons">
                                <h4>Size Comparisons</h4>
                                <ul id="detail-comparisons">
                                    <!-- Size comparisons will be populated by JavaScript -->
                                </ul>
                            </div>
                            <div class="jewelry-detail__actions">
                                <button class="btn btn--primary" id="try-on-button">Try On Virtual</button>
                                <button class="btn btn--secondary" id="compare-button">Add to Compare</button>
                                <button class="btn btn--secondary" id="save-button">Save to Collection</button>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Tab 2: Virtual Try-On -->
            <section id="tab-try-on" class="tab-content">
                <div class="section-header">
                    <h2 class="section-title">Virtual Try-On</h2>
                    <p class="section-description">Upload a photo and see how jewelry looks on you with accurate size overlay.</p>
                </div>

                <!-- Photo Upload Area -->
                <div class="upload-section">
                    <div class="upload-area" id="upload-area">
                        <div class="upload-area__content">
                            <div class="upload-area__icon">📷</div>
                            <h3 class="upload-area__title">Upload Your Photo</h3>
                            <p class="upload-area__text">Drag & drop or click to select</p>
                            <p class="upload-area__hint">For best results: Clear, well-lit photos • Close-up of piercing area • Minimal jewelry</p>
                            <input type="file" id="photo-upload" accept="image/*" class="upload-area__input">
                            <button class="btn btn--primary" id="upload-button">Choose Photo</button>
                        </div>
                    </div>
                </div>

                <!-- Try-On Canvas (shown after photo upload) -->
                <div class="try-on-workspace" id="try-on-workspace" style="display: none;">
                    <div class="try-on-controls">
                        <h3 class="try-on-controls__title">Calibration & Placement</h3>

                        <div class="control-group">
                            <label class="control-label">
                                <span class="control-label__text">Scale Calibration:</span>
                                <span class="control-label__hint">Adjust to match real size</span>
                            </label>
                            <div class="control-input">
                                <button class="btn-icon" id="scale-down">-</button>
                                <input type="range" id="scale-slider" min="50" max="150" value="100" class="slider">
                                <button class="btn-icon" id="scale-up">+</button>
                                <span class="control-value" id="scale-value">100%</span>
                            </div>
                        </div>

                        <div class="control-group">
                            <label class="control-label">
                                <span class="control-label__text">Rotation:</span>
                            </label>
                            <div class="control-input">
                                <button class="btn-icon" id="rotate-left">↶</button>
                                <input type="range" id="rotation-slider" min="0" max="360" value="0" class="slider">
                                <button class="btn-icon" id="rotate-right">↷</button>
                                <span class="control-value" id="rotation-value">0°</span>
                            </div>
                        </div>

                        <div class="control-group">
                            <label class="control-label">
                                <span class="control-label__text">Opacity:</span>
                            </label>
                            <div class="control-input">
                                <input type="range" id="opacity-slider" min="10" max="100" value="100" class="slider">
                                <span class="control-value" id="opacity-value">100%</span>
                            </div>
                        </div>

                        <div class="control-actions">
                            <button class="btn btn--primary" id="save-try-on">Save Result</button>
                            <button class="btn btn--secondary" id="new-photo">New Photo</button>
                            <button class="btn btn--secondary" id="share-try-on">Share</button>
                        </div>
                    </div>

                    <div class="try-on-canvas-container">
                        <canvas id="try-on-canvas" class="try-on-canvas"></canvas>
                        <div class="try-on-info">
                            <p class="try-on-info__text">Click and drag jewelry to position • Use controls to adjust size and rotation</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Tab 3: Size Comparison Tool -->
            <section id="tab-compare" class="tab-content">
                <div class="section-header">
                    <h2 class="section-title">Size Comparison Tool</h2>
                    <p class="section-description">Compare multiple jewelry pieces side-by-side with European paper standards and metric measurements.</p>
                    <div style="background: var(--bg-secondary); padding: 1rem; border-radius: 8px; margin-top: 1rem; border-left: 4px solid var(--color-rose-gold);">
                        <p style="margin: 0; font-size: 0.875rem; color: var(--text-secondary);">
                            <strong>💡 How to use:</strong> Click on any box below to select jewelry items to compare. You can add up to 4 items at once.
                        </p>
                    </div>
                </div>

                <!-- Comparison Selection -->
                <div class="compare-selection">
                    <div class="compare-slot" data-slot="1">
                        <div class="compare-slot__empty">
                            <span class="compare-slot__icon">+</span>
                            <span class="compare-slot__text">Click to Add Item 1</span>
                        </div>
                    </div>
                    <div class="compare-slot" data-slot="2">
                        <div class="compare-slot__empty">
                            <span class="compare-slot__icon">+</span>
                            <span class="compare-slot__text">Click to Add Item 2</span>
                        </div>
                    </div>
                    <div class="compare-slot" data-slot="3">
                        <div class="compare-slot__empty">
                            <span class="compare-slot__icon">+</span>
                            <span class="compare-slot__text">Click to Add Item 3</span>
                        </div>
                    </div>
                    <div class="compare-slot" data-slot="4">
                        <div class="compare-slot__empty">
                            <span class="compare-slot__icon">+</span>
                            <span class="compare-slot__text">Click to Add Item 4</span>
                        </div>
                    </div>
                </div>

                <!-- Comparison Display -->
                <div class="comparison-display" id="comparison-display" style="display: none;">
                    <div class="comparison-canvas-wrapper">
                        <canvas id="comparison-canvas" class="comparison-canvas"></canvas>
                    </div>

                    <div class="comparison-table">
                        <h3 class="comparison-table__title">Detailed Comparison</h3>
                        <table class="specs-table" id="comparison-table">
                            <thead>
                                <tr>
                                    <th>Specification</th>
                                    <th id="compare-header-1">Item 1</th>
                                    <th id="compare-header-2">Item 2</th>
                                    <th id="compare-header-3">Item 3</th>
                                    <th id="compare-header-4">Item 4</th>
                                </tr>
                            </thead>
                            <tbody id="comparison-tbody">
                                <!-- Populated by JavaScript -->
                            </tbody>
                        </table>
                    </div>

                    <!-- Size Reference Standards -->
                    <div class="size-standards">
                        <h4 class="size-standards__title">European Size Standards</h4>
                        <div class="standards-grid">
