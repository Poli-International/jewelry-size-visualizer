    <!-- Tool Title Section -->
    <section class="tool-title-section">
        <div class="container">
            <h1 class="tool-title">Body Piercing Jewelry Size Visualizer & Fitting Guide</h1>
<!-- GitHub CTA -->
<div class='github-cta' style='margin: 1.5rem 0;'>
