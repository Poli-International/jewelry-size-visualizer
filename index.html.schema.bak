    <!-- Calibration Modal -->
    <div class="modal" id="calibration-modal" style="display: none;">
        
        <div class="modal__content">
            <div class="modal__header">
                <h3 class="modal__title">Screen Calibration</h3>
                <button class="modal__close" id="modal-close">✕</button>
            </div>
            <div class="modal__body">
                <p class="modal__description">
                    To display jewelry at true 1:1 scale, we need to calibrate your screen's pixel density (PPI).
                    Please use a physical ruler or credit card to measure the reference below.
                </p>

                <div class="calibration-method">
                    <h4>Method 1: Credit Card</h4>
                    <p>Place a credit card on your screen and adjust the slider until it matches perfectly.</p>
                    <div class="calibration-card" id="calibration-card">
                        <div class="card-mockup">
                            
                            <div class="card-mockup__text">CREDIT CARD</div>
                            <div class="card-mockup__size">85.6mm × 54mm</div>
                        </div>
                    </div>
                    <div class="calibration-slider">
                        <label>Adjust size:</label>
                        <input type="range" id="card-calibration-slider" min="50" max="200" value="100">
                        <span id="card-size-display">85.6mm</span>
                    </div>
                </div>

                <div class="calibration-method">
                    <h4>Method 2: Ruler</h4>
                    <p>Measure the ruler below and adjust until it shows exactly 100mm (10cm).</p>
                    <div class="calibration-ruler" id="calibration-ruler-display">
                        <svg width="100%" height="60" id="ruler-svg">
                            <!-- Ruler will be drawn by JavaScript -->
                        </svg>
                    </div>
                    <div class="calibration-slider">
                        <label>Adjust size:</label>
                        <input type="range" id="ruler-calibration-slider" min="50" max="200" value="100">
                        <span id="ruler-size-display">100mm</span>
                    </div>
                </div>

                <div class="calibration-auto">
                    <h4>Or Use Auto-Detection</h4>
                    <p>We'll estimate your screen's PPI based on your device specifications.</p>
                    <button class="btn btn--secondary" id="auto-detect-ppi">Auto-Detect PPI</button>
                    <p class="calibration-auto__result" id="auto-detect-result"></p>
                </div>
            </div>
            <div class="modal__footer">
                <button class="btn btn--primary" id="save-calibration">Save Calibration</button>
                <button class="btn btn--secondary" id="skip-calibration">Skip for Now</button>
            </div>
        </div>
    </div>

