                    <!-- Safety Warnings -->
                    <div class="safety-warnings">
                        <h4 class="safety-warnings__title">⚠️ Important Safety Guidelines</h4>
                        <ul class="safety-list">
                            <li><strong>Never force jewelry:</strong> If there's resistance, pain, or bleeding, stop immediately</li>
                            <li><strong>Wait for complete healing:</strong> Minimum 4 weeks between stretches, longer for larger gauges</li>
                            <li><strong>Use proper tools:</strong> Glass or steel single-flare plugs, never tapers alone</li>
                            <li><strong>Massage daily:</strong> Use vitamin E oil or jojoba oil to improve elasticity</li>
                            <li><strong>Downsize if needed:</strong> Thinning tissue, pain, or "cheese-cutting" requires downsizing</li>
                            <li><strong>Professional consultation:</strong> See a piercer if you experience complications</li>
                        </ul>
                    </div>
                </div>
