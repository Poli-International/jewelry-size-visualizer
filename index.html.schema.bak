<!-- IFRAME DETECTION - RUNS IMMEDIATELY -->
<script>
(function() {
    'use strict';

    // Detect if we're in an iframe
    var isInIframe = (window.self !== window.top);

    if (isInIframe) {
        console.log('[IFRAME MODE] Detected - cleaning up...');

        // Add style to HEAD immediately to prevent loading/showing elements
        var style = document.createElement('style');
        style.textContent = `
            .site-header,
            .tool-title-section,
            header,
            footer,
            .footer,
            .community-feedback,
            .feedback-section,
            .newsletter-section,
            .email-signup,
            .get-notified,
            .social-share {
                display: none !important;
                visibility: hidden !important;
            }
            .nav-tabs {
                top: 0 !important;
                position: sticky !important;
            }
            body {
                padding-top: 0 !important;
                margin-top: 0 !important;
            }
            .main, main {
                padding-top: 1rem !important;
                margin-top: 0 !important;
            }
        `;
        document.head.appendChild(style);

        // Also remove from DOM when page loads
        document.addEventListener('DOMContentLoaded', function() {
            var selectorsToRemove = [
                '.site-header',
                '.tool-title-section',
                'header:not(.visualizer-header):not(.gauge-converter__header)',
                'footer',
                '.footer',
                '.community-feedback',
                '.feedback-section',
                '.newsletter-section',
                '.email-signup',
                '.get-notified',
                '.social-share'
            ];

            selectorsToRemove.forEach(function(selector) {
                var elements = document.querySelectorAll(selector);
                elements.forEach(function(el) {
                    if (el && el.parentNode) {
                        el.parentNode.removeChild(el);
                        console.log('[IFRAME MODE] Removed:', selector);
                    }
                });
            });

            // Fix nav positioning
            var navTabs = document.querySelector('.nav-tabs');
            if (navTabs) {
                navTabs.style.top = '0';
                navTabs.style.position = 'sticky';
                console.log('[IFRAME MODE] Fixed nav position');
            }

            console.log('[IFRAME MODE] Cleanup complete!');
        });
    }
})();
</script>

